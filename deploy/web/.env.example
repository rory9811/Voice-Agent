# Realtime-Venus web service, Harness and task agent (your computer). Copy to .env and edit.

# Model server address: the GPU server's VPN address and its MODEL_PORT
MODEL_URL=http://10.194.99.8:8031
# Same secret as VENUS_MODEL_TOKEN in deploy/model/.env
VENUS_MODEL_TOKEN=
# The page opens at http://localhost:<WEB_PORT>
WEB_PORT=8032
# Seconds to wait for the model when opening or closing a conversation
MODEL_TIMEOUT_S=180
# Settings, agent logins and task files; start relative paths with ./ (relative to deploy/web)
DATA_DIR=./data
# Optional official Gemini API key (it can also be entered in Settings)
GEMINI_API_KEY=

# Build settings: switch to mirrors if Docker Hub or PyPI is slow; keep the image's @sha256 digest
PYTHON_IMAGE=python:3.11.18-slim-trixie@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60
PIP_INDEX_URL=https://pypi.org/simple
