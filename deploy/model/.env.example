# Realtime-Venus model server (GPU server). Copy to .env and edit.

# omni: camera + microphone and video upload; audio: microphone and audio upload
MODEL_TYPE=omni
# Download root: the folder holding config.yaml and Realtime-Venus-Omni/ or
# Realtime-Venus-Audio/ (the repository root with the default download); both
# checkpoints read that config.yaml. Start relative paths with ./ or ../ (relative
# to deploy/model); without the prefix Compose creates an empty named volume instead.
MODEL_DIR=../..
# Reference voice, relative to the selected checkpoint folder
REFERENCE_AUDIO=assets/HT_ref_audio.wav
# Port your computer uses to reach the model; it must be reachable over the VPN
MODEL_PORT=8031
# Omni video memory in minutes (unused by Audio)
MEMORY_MINUTES=40
# GPU index to use
GPU_DEVICE=0
# Shared secret; set the same value in deploy/web/.env. On a shared server: chmod 600 .env
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
VENUS_MODEL_TOKEN=

# Build settings: switch to mirrors if Docker Hub or PyPI is slow; keep the image's @sha256 digest
PYTHON_IMAGE=python:3.11.18-slim-trixie@sha256:673719e071ecf27434fd2635bbd8d00f49f4fdd81f243143438a42ced8bedf60
PIP_INDEX_URL=https://pypi.org/simple
